# Windows files should use crlf line endings
# https://help.github.com/articles/dealing-with-line-endings/
*.bat text eol=crlf

# The native SDK recovery snapshot must contain its exact bytes in every clone.
vendor/tangem/** -text -filter
# Preserve whitespace in the original cached iOS sources as well.
vendor/tangem/ios/TangemSdk/** -whitespace
