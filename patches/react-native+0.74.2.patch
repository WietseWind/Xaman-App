+// One shared native address serves every synchronous method. Record the
+// module and method before the call so a native abort can name it.
+void noteSyncNativeCall(const std::string& name) noexcept {
+  static std::once_flag once;
+  static jclass traceClass = nullptr;
+  static jmethodID noteMethod = nullptr;
+  static bool ready = false;
+
+  if (name.empty()) {
+    return;
+  }
+
+  JNIEnv* env = facebook::jni::Environment::current();
+  if (env == nullptr) {
+    return;
+  }
+
+  std::call_once(once, [env] {
+    jclass local = env->FindClass("com/xrpllabs/xumm/SyncNativeTrace");
+    if (local == nullptr || env->ExceptionCheck()) {
+      if (env->ExceptionCheck()) {
+        env->ExceptionClear();
+      }
+      return;
+    }
+    traceClass = static_cast<jclass>(env->NewGlobalRef(local));
+    env->DeleteLocalRef(local);
+    if (traceClass == nullptr) {
+      return;
+    }
+    noteMethod = env->GetStaticMethodID(
+        traceClass, "note", "(Ljava/lang/String;)V");
+    if (noteMethod == nullptr || env->ExceptionCheck()) {
+      if (env->ExceptionCheck()) {
+        env->ExceptionClear();
+      }
+      return;
+    }
+    ready = true;
+  });
+
+  if (!ready) {
+    return;
+  }
+
+  jstring jname = env->NewStringUTF(name.c_str());
+  if (jname == nullptr) {
+    if (env->ExceptionCheck()) {
+      env->ExceptionClear();
+    }
+    return;
+  }
+  env->CallStaticVoidMethod(traceClass, noteMethod, jname);
+  env->DeleteLocalRef(jname);
+  if (env->ExceptionCheck()) {
+    env->ExceptionClear();
+  }
+}
+
+} // namespace
