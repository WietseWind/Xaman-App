+import { BinaryParser } from '../serdes/binary-parser'
+import { Amount, AmountObject } from './amount'
+
+/** Native XRP deltas only; normal payment and fee fields still use Amount. */
+class SignedAmount extends Amount {
+  static from<T extends Amount | AmountObject | string>(value: T): SignedAmount {
+    if (value instanceof Amount) {
+      if (!value.isNative()) throw new Error('SignedAmount only supports native XRP')
+      return new SignedAmount(value.toBytes().slice())
+    }
+    if (typeof value !== 'string' || !/^-?\d+$/.test(value)) {
+      throw new Error('SignedAmount requires an integer XRP drops string')
+    }
+
+    const magnitude = value.replace(/^-/, '')
+    // Reuse the existing XRP magnitude limits; do not weaken Amount validation.
+    const bytes = Amount.from(magnitude).toBytes().slice()
+    if (value.startsWith('-') && BigInt(value) !== BigInt(0)) bytes[0] &= 0x3f
+    return new SignedAmount(bytes)
+  }
+
+  static fromParser(parser: BinaryParser): SignedAmount {
+    const value = Amount.fromParser(parser)
+    if (!value.isNative()) throw new Error('SignedAmount only supports native XRP')
+    return new SignedAmount(value.toBytes().slice())
+  }
+
+  toJSON(): AmountObject | string {
+    // This version of Amount.toJSON clears the sign bit on its own byte array.
+    // Decode a copy so repeated reads cannot alter a signed delta's wire bytes.
+    return new Amount(this.toBytes().slice()).toJSON()
+  }
+}
+
+export { SignedAmount }
