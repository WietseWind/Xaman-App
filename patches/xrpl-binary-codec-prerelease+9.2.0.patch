+import { BinaryParser } from '../serdes/binary-parser'
+import { SerializedType } from './serialized-type'
+import { readInt32BE, writeInt32BE } from '../utils'
+
+/** Signed, big-endian 32-bit integers used by loan and sponsorship fields. */
+class Int32 extends SerializedType {
+  static fromParser(parser: BinaryParser): Int32 {
+    return new Int32(parser.read(4))
+  }
+
+  static from<T extends Int32 | number | string>(value: T): Int32 {
+    if (value instanceof Int32) return value
+
+    const number = typeof value === 'string' && /^-?\d+$/.test(value)
+      ? Number(value)
+      : value
+    if (typeof number !== 'number' || !Number.isInteger(number) ||
+        number < -2147483648 || number > 2147483647) {
+      throw new Error('Int32 must be an integer between -2147483648 and 2147483647')
+    }
+    const bytes = new Uint8Array(4)
+    writeInt32BE(bytes, number, 0)
+    return new Int32(bytes)
+  }
+
+  valueOf(): number {
+    return readInt32BE(this.bytes, 0)
+  }
+
+  toJSON(): number {
+    return this.valueOf()
+  }
+}
+
+export { Int32 }
