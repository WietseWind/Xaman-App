+      if captureSession.isMultitaskingCameraAccessSupported {
+        captureSession.isMultitaskingCameraAccessEnabled = true
+      }
+    }
+  }
+
+  private func previewBlocked(by reason: AVCaptureSession.InterruptionReason?) -> Bool {
+    switch reason {
+    case .videoDeviceNotAvailableWithMultipleForegroundApps,
+         .videoDeviceInUseByAnotherClient,
+         .videoDeviceNotAvailableInBackground,
+         .videoDeviceNotAvailableDueToSystemPressure:
+      return true
+    default:
+      if #available(iOS 26.0, *), reason == .sensitiveContentMitigationActivated {
+        return true
+      }
+      return false
+    }
+  }
+
+  /// A stopped preview used to stay black behind the crosshairs, because this interruption is not an error.
+  @objc
+  func sessionWasInterrupted(notification: Notification) {
+    guard (notification.object as? AVCaptureSession) === captureSession else {
+      return
+    }
+    let raw = (notification.userInfo?[AVCaptureSessionInterruptionReasonKey] as? NSNumber)?.intValue ?? -1
+    let reason = AVCaptureSession.InterruptionReason(rawValue: raw)
+    NSLog("VisionCamera session interrupted reason=%d", raw)
+    guard previewBlocked(by: reason) else {
+      return
+    }
+    if interruptionRestarts < 1 && configuration?.isActive == true {
+      interruptionRestarts += 1
+      CameraQueues.cameraQueue.asyncAfter(deadline: .now() + 0.4) { [weak self] in
+        guard let self else { return }
+        guard self.configuration?.isActive == true, !self.captureSession.isRunning else { return }
+        self.allowPreviewWhileNotExclusiveFullscreen()
+        self.captureSession.startRunning()
+        if self.captureSession.isRunning {
+          self.interruptionRestarts = 0
+        }
+      }
+      return
+    }
+    delegate?.onError(.unknown(message: "The camera preview stopped because the camera is not available."))
+  }
 
