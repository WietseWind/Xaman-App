+- (void)sessionTask:(NSURLSessionTask *)task
+ willPerformHTTPRedirection:(NSHTTPURLResponse *)response
+         newRequest:(NSURLRequest *)request
+  completionHandler:(void (^)(NSURLRequest *_Nullable))completionHandler {
+  XamanOttTaskBox *box = [self boxForSessionTask:task];
+  if (box == nil || box.stopped || box.finished || box.redirects >= 8) {
+    completionHandler(nil);
+    return;
+  }
+  box.redirects += 1;
+  NSURL *from = task.originalRequest.URL ?: task.currentRequest.URL;
+  [self.scope noteRedirectFromHost:from.host toHost:request.URL.host document:box.document];
+  [self ignoreSessionTask:task];
+  completionHandler(nil);
+  [self performRedirect:response request:request box:box];
+}
+
+- (void)sessionDataTask:(NSURLSessionDataTask *)dataTask
+     didReceiveResponse:(NSURLResponse *)response
+      completionHandler:(void (^)(NSURLSessionResponseDisposition))completionHandler {
+  if ([self isIgnoredSessionTask:dataTask]) {
+    completionHandler(NSURLSessionResponseCancel);
+    return;
+  }
+  XamanOttTaskBox *box = [self boxForSessionTask:dataTask];
+  if (box == nil || box.stopped || box.finished || ![response isKindOfClass:[NSHTTPURLResponse class]]) {
+    completionHandler(NSURLSessionResponseCancel);
+    if (box != nil) {
+      [self finishBox:box error:[NSError errorWithDomain:NSURLErrorDomain code:NSURLErrorBadServerResponse userInfo:nil]];
+    }
+    return;
+  }
+  NSHTTPURLResponse *http = (NSHTTPURLResponse *)response;
+  if (box.document) {
+    [self.scope noteDocumentStatus:http.statusCode];
+  }
+  [self receiveResponse:[self cleanResponse:http] box:box];
+  completionHandler(NSURLSessionResponseAllow);
+}
+
+- (void)sessionDataTask:(NSURLSessionDataTask *)dataTask didReceiveData:(NSData *)data {
+  if ([self isIgnoredSessionTask:dataTask]) {
+    return;
+  }
+  XamanOttTaskBox *box = [self boxForSessionTask:dataTask];
+  [self receiveData:data box:box];
+}
+
+- (void)sessionTask:(NSURLSessionTask *)task didCompleteWithError:(NSError *)error {
+  BOOL ignored = [self isIgnoredSessionTask:task];
+  XamanOttTaskBox *box = [self boxForSessionTask:task];
+  [self forgetSessionTask:task];
+  if (ignored || box == nil) {
+    return;
+  }
+  if (box.dataTask != nil && box.dataTask != task) {
+    return;
+  }
+  [self finishBox:box error:error];
+}
