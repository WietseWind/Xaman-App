+- (void)xamanStripCookiesAndServiceWorkersFromStore:(WKWebsiteDataStore *)store
+{
+  if (store == nil) {
+    return;
+  }
+  NSMutableSet *types = [NSMutableSet setWithObject:WKWebsiteDataTypeCookies];
+  if (@available(iOS 16.0, *)) {
+    [types addObject:WKWebsiteDataTypeServiceWorkerRegistrations];
+  }
+  [store removeDataOfTypes:types
+             modifiedSince:[NSDate dateWithTimeIntervalSince1970:0]
+         completionHandler:^{}];
+}
+
+- (void)xamanAttachCookieBlockListToController:(WKUserContentController *)controller
+{
+  if (controller == nil) {
+    return;
+  }
+  static WKContentRuleList *cachedList;
+  static NSMutableArray<WKUserContentController *> *pendingControllers;
+  static BOOL compiling;
+  if (cachedList != nil) {
+    [controller addContentRuleList:cachedList];
+    return;
+  }
+  if (pendingControllers == nil) {
+    pendingControllers = [NSMutableArray new];
+  }
+  [pendingControllers addObject:controller];
+  if (compiling) {
+    return;
+  }
+  compiling = YES;
+  NSString *json = @"[{\"trigger\":{\"url-filter\":\".*\"},\"action\":{\"type\":\"block-cookies\"}}]";
+  [[WKContentRuleListStore defaultStore]
+      compileContentRuleListForIdentifier:RNCXamanCookieBlockListId
+                    encodedContentRuleList:json
+                       completionHandler:^(WKContentRuleList *list, NSError *error) {
+                         compiling = NO;
+                         if (list == nil) {
+                           [pendingControllers removeAllObjects];
+                           return;
+                         }
+                         cachedList = list;
+                         for (WKUserContentController *pending in pendingControllers) {
+                           [pending addContentRuleList:list];
+                         }
+                         [pendingControllers removeAllObjects];
+                       }];
+}
