+- (void)webView:(WKWebView *)webView startURLSchemeTask:(id<WKURLSchemeTask>)urlSchemeTask {
+  NSURLRequest *original = urlSchemeTask.request;
+  NSURL *url = original.URL;
+  NSString *scheme = url.scheme.lowercaseString;
+  if (url == nil || !([scheme isEqualToString:@"https"] || [scheme isEqualToString:@"http"])) {
+    [self failTask:urlSchemeTask error:[NSError errorWithDomain:NSURLErrorDomain code:NSURLErrorUnsupportedURL userInfo:nil]];
+    return;
+  }
+
+  BOOL document = [self isDocumentRequest:original];
+  BOOL keep = [self.scope observeHost:url.host path:url.path ?: @"" document:document redirect:NO];
+  NSMutableURLRequest *next = [self forwardingRequest:original keepOtt:keep];
+  XamanOttTaskBox *box = [XamanOttTaskBox new];
+  box.schemeTask = urlSchemeTask;
+  box.document = document;
+  @synchronized(self) {
+    [self.boxByScheme setObject:box forKey:urlSchemeTask];
+  }
+  [self startDataTask:next box:box];
+}
+
+- (void)webView:(WKWebView *)webView stopURLSchemeTask:(id<WKURLSchemeTask>)urlSchemeTask {
+  XamanOttTaskBox *box;
+  @synchronized(self) {
+    box = [self.boxByScheme objectForKey:urlSchemeTask];
+  }
+  if (box == nil) {
+    return;
+  }
+  box.stopped = YES;
+  [box.dataTask cancel];
+}
+
+- (BOOL)isDocumentRequest:(NSURLRequest *)request {
+  NSString *dest = [request valueForHTTPHeaderField:@"Sec-Fetch-Dest"];
+  if (dest.length > 0) {
+    return [dest isEqualToString:@"document"] || [dest isEqualToString:@"iframe"];
+  }
+  NSString *mode = [request valueForHTTPHeaderField:@"Sec-Fetch-Mode"];
+  if ([mode isEqualToString:@"navigate"]) {
+    return YES;
+  }
+  if (request.URL != nil && request.mainDocumentURL != nil && [self sameDocument:request.URL other:request.mainDocumentURL]) {
+    return YES;
+  }
+  NSString *accept = [request valueForHTTPHeaderField:@"Accept"] ?: @"";
+  return [accept containsString:@"text/html"];
+}
+
+- (BOOL)sameDocument:(NSURL *)left other:(NSURL *)right {
+  NSURLComponents *a = [NSURLComponents componentsWithURL:left resolvingAgainstBaseURL:NO];
+  NSURLComponents *b = [NSURLComponents componentsWithURL:right resolvingAgainstBaseURL:NO];
+  if (a == nil || b == nil) {
+    return [left.absoluteString isEqualToString:right.absoluteString];
+  }
+  a.fragment = nil;
+  b.fragment = nil;
+  return [a.string.lowercaseString isEqualToString:b.string.lowercaseString];
+}
+
+- (NSMutableURLRequest *)forwardingRequest:(NSURLRequest *)request keepOtt:(BOOL)keep {
+  NSMutableURLRequest *next = [request mutableCopy];
+  NSData *body = [self bodyOf:request];
+  if (body != nil) {
+    next.HTTPBodyStream = nil;
+    next.HTTPBody = body;
+  }
+  if (!keep) {
+    NSString *userAgent = [next valueForHTTPHeaderField:@"User-Agent"];
+    if ([userAgent containsString:@"(ott:"]) {
+      [next setValue:[XamanOttScope stripOtt:userAgent] forHTTPHeaderField:@"User-Agent"];
+    }
+    [next setValue:nil forHTTPHeaderField:@"X-OTT"];
+  }
+  return next;
+}
+
+- (NSData *)bodyOf:(NSURLRequest *)request {
+  if (request.HTTPBody.length > 0) {
+    return request.HTTPBody;
+  }
+  NSInputStream *stream = request.HTTPBodyStream;
+  if (stream == nil) {
+    return nil;
+  }
+  NSMutableData *data = [NSMutableData data];
+  [stream open];
+  uint8_t buffer[16 * 1024];
+  while (YES) {
+    NSInteger count = [stream read:buffer maxLength:sizeof(buffer)];
+    if (count <= 0) {
+      break;
+    }
+    [data appendBytes:buffer length:(NSUInteger)count];
+  }
+  [stream close];
+  return data;
+}
+
+- (void)startDataTask:(NSURLRequest *)request box:(XamanOttTaskBox *)box {
+  if (box.stopped || box.finished) {
+    return;
+  }
+  NSURLSessionDataTask *dataTask = [[self ensureSession] dataTaskWithRequest:request];
+  box.dataTask = dataTask;
+  @synchronized(self) {
+    [self.boxBySessionTask setObject:box forKey:dataTask];
+  }
+  [dataTask resume];
+}
+
+- (XamanOttTaskBox *)boxForSessionTask:(NSURLSessionTask *)task {
+  @synchronized(self) {
+    return [self.boxBySessionTask objectForKey:task];
+  }
+}
+
+- (BOOL)isIgnoredSessionTask:(NSURLSessionTask *)task {
+  @synchronized(self) {
+    return [self.ignoredSessionTasks containsObject:task];
+  }
+}
+
+- (void)ignoreSessionTask:(NSURLSessionTask *)task {
+  @synchronized(self) {
+    [self.ignoredSessionTasks addObject:task];
+  }
+}
+
+- (void)forgetSessionTask:(NSURLSessionTask *)task {
+  @synchronized(self) {
+    [self.ignoredSessionTasks removeObject:task];
+    [self.boxBySessionTask removeObjectForKey:task];
+  }
+}
+
+- (void)forgetBox:(XamanOttTaskBox *)box {
+  @synchronized(self) {
+    if (box.schemeTask != nil) {
+      [self.boxByScheme removeObjectForKey:box.schemeTask];
+    }
+    if (box.dataTask != nil) {
+      [self.boxBySessionTask removeObjectForKey:box.dataTask];
+    }
+  }
+}
