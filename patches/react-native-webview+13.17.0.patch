+  }
+  NSRange last = [normalized rangeOfString:@"." options:NSBackwardsSearch];
+  if (last.location == NSNotFound || last.location == 0) {
+    return normalized;
+  }
+  NSRange previous = [normalized rangeOfString:@"." options:NSBackwardsSearch range:NSMakeRange(0, last.location)];
+  return previous.location == NSNotFound ? normalized : [normalized substringFromIndex:previous.location + 1];
+}
