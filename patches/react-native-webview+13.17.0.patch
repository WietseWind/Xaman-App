+- (BOOL)matchesAllowed:(NSString *)host {
+  for (NSString *allowed in self.allowedHosts) {
+    if ([XamanOttScope sameSite:host asHost:allowed]) {
+      return YES;
+    }
+  }
+  return NO;
+}
+
++ (NSString *)stripOtt:(NSString *)userAgent {
+  if (userAgent.length == 0) {
+    return @"";
+  }
+  static NSRegularExpression *regex;
+  static dispatch_once_t once;
+  dispatch_once(&once, ^{
+    regex = [NSRegularExpression regularExpressionWithPattern:@"\\s*\\(ott:[^)]*\\)" options:0 error:nil];
+  });
+  if (regex == nil) {
+    return userAgent;
+  }
+  return [regex stringByReplacingMatchesInString:userAgent
+                                         options:0
+                                           range:NSMakeRange(0, userAgent.length)
+                                    withTemplate:@""];
+}
+
+- (BOOL)keeps:(NSString *)host {
+  @synchronized(self) {
+    NSString *normalized = [XamanOttScope normalizeHost:host];
+    if (normalized.length == 0) {
+      return YES;
+    }
+    return [XamanOttScope isOwnHost:normalized] || [self matchesAllowed:normalized];
+  }
+}
+
+- (void)noteRedirectFromHost:(NSString *)fromHost toHost:(NSString *)toHost document:(BOOL)document {
+  @synchronized(self) {
+    if (!document) {
+      return;
+    }
+    NSString *to = [XamanOttScope normalizeHost:toHost];
+    if (to.length == 0 || [XamanOttScope isOwnHost:to]) {
+      return;
+    }
+    NSString *from = [XamanOttScope normalizeHost:fromHost];
+    BOOL fromKnown = from.length > 0 && ([XamanOttScope isOwnHost:from] || [self matchesAllowed:from] || self.chainOpen);
+    if (!fromKnown) {
+      return;
+    }
+    [self.allowedHosts addObject:to];
+    self.pinnedHost = to;
+    self.chainOpen = YES;
+    self.expectingRedirect = YES;
+  }
+}
+
+- (void)noteDocumentStatus:(NSInteger)status {
+  @synchronized(self) {
+    if (status >= 300 && status < 400) {
+      self.expectingRedirect = YES;
+      return;
+    }
+    self.chainOpen = NO;
+    self.expectingRedirect = NO;
+  }
+}
+
+- (BOOL)observeHost:(NSString *)host path:(NSString *)path document:(BOOL)document redirect:(BOOL)redirect {
+  @synchronized(self) {
+    NSString *normalized = [XamanOttScope normalizeHost:host];
+    if (normalized.length == 0) {
+      return YES;
+    }
+    NSString *requestPath = path ?: @"";
+    if ([XamanOttScope isOwnHost:normalized]) {
+      if (document && !redirect && [XamanOttScope isDetectLaunch:requestPath]) {
+        self.pinnedHost = nil;
+        [self.allowedHosts removeAllObjects];
+        self.chainOpen = NO;
+        self.expectingRedirect = NO;
+      }
+      return YES;
+    }
+    if ([self matchesAllowed:normalized]) {
+      if (!document && self.chainOpen && !self.expectingRedirect) {
+        self.chainOpen = NO;
+      }
+      return YES;
+    }
+    if (document) {
+      BOOL first = self.pinnedHost.length == 0 && self.allowedHosts.count == 0;
+      BOOL follow = self.chainOpen && (redirect || self.expectingRedirect);
+      if (first || follow) {
+        [self.allowedHosts addObject:normalized];
+        self.pinnedHost = normalized;
+        self.chainOpen = YES;
+        self.expectingRedirect = NO;
+        return YES;
+      }
+      return NO;
+    }
+    return NO;
+  }
+}
