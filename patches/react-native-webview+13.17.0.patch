+- (void)performRedirect:(NSHTTPURLResponse *)response request:(NSURLRequest *)request box:(XamanOttTaskBox *)box {
+  if (box.stopped || box.finished) {
+    return;
+  }
+  SEL selector = NSSelectorFromString(@"_willPerformRedirection:newRequest:completionHandler:");
+  if (![box.schemeTask respondsToSelector:selector]) {
+    BOOL keep = [self.scope keeps:request.URL.host];
+    [self startDataTask:[self forwardingRequest:request keepOtt:keep] box:box];
+    return;
+  }
+
+  __weak XamanOttSchemeHandler *weakSelf = self;
+  __weak XamanOttTaskBox *weakBox = box;
+  void (^completion)(NSURLRequest *) = ^(NSURLRequest *updated) {
+    XamanOttSchemeHandler *strongSelf = weakSelf;
+    XamanOttTaskBox *strongBox = weakBox;
+    if (strongSelf == nil || strongBox == nil || strongBox.stopped || strongBox.finished || updated.URL == nil) {
+      return;
+    }
+    BOOL keep = [strongSelf.scope keeps:updated.URL.host];
+    [strongSelf startDataTask:[strongSelf forwardingRequest:updated keepOtt:keep] box:strongBox];
+  };
+  void (^heapCompletion)(NSURLRequest *) = [completion copy];
+
+  @try {
+    NSMethodSignature *signature = [(NSObject *)box.schemeTask methodSignatureForSelector:selector];
+    NSInvocation *invocation = [NSInvocation invocationWithMethodSignature:signature];
+    invocation.target = box.schemeTask;
+    invocation.selector = selector;
+    NSHTTPURLResponse *redirectResponse = response;
+    NSURLRequest *redirectRequest = request;
+    [invocation setArgument:&redirectResponse atIndex:2];
+    [invocation setArgument:&redirectRequest atIndex:3];
+    [invocation setArgument:&heapCompletion atIndex:4];
+    [invocation retainArguments];
+    [invocation invoke];
+  } @catch (NSException *exception) {
+    BOOL keep = [self.scope keeps:request.URL.host];
+    [self startDataTask:[self forwardingRequest:request keepOtt:keep] box:box];
+  }
+}
