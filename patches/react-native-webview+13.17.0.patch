++ (BOOL)sameSite:(NSString *)host asHost:(NSString *)allowed {
+  NSString *left = [self siteRoot:host];
+  NSString *right = [self siteRoot:allowed];
+  return left.length > 0 && [left isEqualToString:right];
+}
