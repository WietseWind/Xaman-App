++ (BOOL)isClaimingBuiltinSchemes {
+  return XamanOttClaimBuiltinSchemes;
+}
+
++ (void)claimBuiltinSchemesWhile:(void (^)(void))block {
+  if (block == nil) {
+    return;
+  }
+  if (XamanOttOriginalHandlesURLScheme == NULL) {
+    block();
+    return;
+  }
+  @synchronized([XamanOttSchemeHandler class]) {
+    XamanOttClaimBuiltinSchemes = YES;
+    @try {
+      block();
+    } @finally {
+      XamanOttClaimBuiltinSchemes = NO;
+    }
+  }
+}
