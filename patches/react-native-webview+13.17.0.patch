+- (void)receiveResponse:(NSURLResponse *)response box:(XamanOttTaskBox *)box {
+  if (box.stopped || box.finished) {
+    return;
+  }
+  @try {
+    [box.schemeTask didReceiveResponse:response];
+    box.receivedResponse = YES;
+  } @catch (NSException *exception) {
+    box.stopped = YES;
+  }
+}
+
+- (void)receiveData:(NSData *)data box:(XamanOttTaskBox *)box {
+  if (box.stopped || box.finished || data.length == 0) {
+    return;
+  }
+  @try {
+    [box.schemeTask didReceiveData:data];
+  } @catch (NSException *exception) {
+    box.stopped = YES;
+  }
+}
+
+- (void)finishBox:(XamanOttTaskBox *)box error:(NSError *)error {
+  if (box == nil || box.finished) {
+    return;
+  }
+  box.finished = YES;
+  if (!box.stopped) {
+    @try {
+      if (!box.receivedResponse) {
+        NSError *failure = error ?: [NSError errorWithDomain:NSURLErrorDomain code:NSURLErrorBadServerResponse userInfo:nil];
+        [box.schemeTask didFailWithError:failure];
+      } else if (error != nil && error.code != NSURLErrorCancelled) {
+        [box.schemeTask didFailWithError:error];
+      } else if (error == nil) {
+        [box.schemeTask didFinish];
+      }
+    } @catch (NSException *exception) {
+    }
+  }
+  [self forgetBox:box];
+}
