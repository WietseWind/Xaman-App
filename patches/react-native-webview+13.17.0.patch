++ (void)load {
+  static dispatch_once_t once;
+  dispatch_once(&once, ^{
+    Method method = class_getClassMethod([WKWebView class], @selector(handlesURLScheme:));
+    if (method == NULL) {
+      return;
+    }
+    XamanOttOriginalHandlesURLScheme = method_getImplementation(method);
+    method_setImplementation(method, (IMP)XamanOttHandlesURLScheme);
+  });
+}
