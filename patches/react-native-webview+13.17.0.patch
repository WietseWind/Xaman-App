+/**
+ * Re-fetches requests that must not see the xApp one-time token.
+ * Allowed hosts return null so the WebView loads them unchanged.
+ * A proxy failure also returns null: the resource still loads, with the token.
+ */
+final class XamanOttInterceptor {
+    private static final int MAX_REDIRECTS = 5;
+    private static final int CONNECT_TIMEOUT_MS = 15000;
+    private static final int READ_TIMEOUT_MS = 20000;
+
+    private XamanOttInterceptor() {
+    }
+
+    static WebResourceResponse intercept(XamanOttScope scope, WebResourceRequest request) throws IOException {
+        Uri uri = request.getUrl();
+        if (uri == null) {
+            return null;
+        }
+        String scheme = uri.getScheme();
+        if (scheme == null || (!scheme.equalsIgnoreCase("http") && !scheme.equalsIgnoreCase("https"))) {
+            return null;
+        }
+
+        Map<String, String> headers = request.getRequestHeaders();
+        String userAgent = header(headers, "User-Agent");
+        if (userAgent == null || !userAgent.contains("(ott:")) {
+            return null;
+        }
+
+        String path = uri.getPath() == null ? "" : uri.getPath();
+        boolean document = isDocument(request, headers);
+        boolean redirect = Build.VERSION.SDK_INT >= Build.VERSION_CODES.N && request.isRedirect();
+        boolean keep;
+        synchronized (scope) {
+            keep = scope.observe(uri.getHost(), path, document, redirect);
+        }
+        if (keep) {
+            return null;
+        }
+
+        String method = request.getMethod() == null ? "GET" : request.getMethod().toUpperCase(Locale.US);
+        if (!method.equals("GET") && !method.equals("HEAD") && !method.equals("OPTIONS")) {
+            // The request body is not available here. Let the WebView send it.
+            return null;
+        }
+
+        return fetchStripped(scope, uri.toString(), method, headers, userAgent);
+    }
+
+    private static boolean isDocument(WebResourceRequest request, Map<String, String> headers) {
+        if (request.isForMainFrame()) {
+            return true;
+        }
+        String dest = header(headers, "Sec-Fetch-Dest");
+        if (dest != null && !dest.isEmpty()) {
+            return dest.equals("document") || dest.equals("iframe");
+        }
+        String mode = header(headers, "Sec-Fetch-Mode");
+        if ("navigate".equals(mode)) {
+            return true;
+        }
+        String accept = header(headers, "Accept");
+        return accept != null && accept.contains("text/html");
+    }
+
+    private static String header(Map<String, String> headers, String name) {
+        if (headers == null) {
+            return null;
+        }
+        for (Map.Entry<String, String> entry : headers.entrySet()) {
+            if (entry.getKey() != null && entry.getKey().equalsIgnoreCase(name)) {
+                return entry.getValue();
+            }
+        }
+        return null;
+    }
+
+    private static WebResourceResponse fetchStripped(
+        XamanOttScope scope,
+        String urlString,
+        String method,
+        Map<String, String> requestHeaders,
+        String originalUserAgent
+    ) throws IOException {
+        String strippedUserAgent = XamanOttScope.stripOtt(originalUserAgent);
+        URL current = new URL(urlString);
+        String userAgent = strippedUserAgent;
+
+        for (int hop = 0; hop < MAX_REDIRECTS; hop++) {
+            HttpURLConnection conn = open(current, method, requestHeaders, userAgent);
+            int status = conn.getResponseCode();
+            if (status >= 300 && status < 400) {
+                String location = conn.getHeaderField("Location");
+                conn.disconnect();
+                if (location == null || location.isEmpty()) {
+                    break;
+                }
+                URL next = new URL(current, location);
+                String nextScheme = next.getProtocol();
+                if (nextScheme == null || (!nextScheme.equalsIgnoreCase("http") && !nextScheme.equalsIgnoreCase("https"))) {
+                    break;
+                }
+                userAgent = scope.keeps(next.getHost()) ? originalUserAgent : strippedUserAgent;
+                current = next;
+                if (status == 303 || ((status == 301 || status == 302) && !method.equals("GET") && !method.equals("HEAD"))) {
+                    method = "GET";
+                }
+                continue;
+            }
+            return responseFor(conn, status, method);
+        }
+        return null;
+    }
+
+    private static HttpURLConnection open(
+        URL url,
+        String method,
+        Map<String, String> requestHeaders,
+        String userAgent
+    ) throws IOException {
+        HttpURLConnection conn = (HttpURLConnection) url.openConnection();
+        conn.setInstanceFollowRedirects(false);
+        conn.setConnectTimeout(CONNECT_TIMEOUT_MS);
+        conn.setReadTimeout(READ_TIMEOUT_MS);
+        conn.setUseCaches(false);
+        conn.setRequestMethod(method);
+        if (requestHeaders != null) {
+            for (Map.Entry<String, String> entry : requestHeaders.entrySet()) {
+                String key = entry.getKey();
+                if (key == null || isHopByHop(key) || key.equalsIgnoreCase("User-Agent") || key.equalsIgnoreCase("X-OTT")) {
+                    continue;
+                }
+                try {
+                    conn.setRequestProperty(key, entry.getValue());
+                } catch (IllegalArgumentException | IllegalStateException ignored) {
+                    // Restricted headers are filled in by the client.
+                }
+            }
+        }
+        conn.setRequestProperty("User-Agent", userAgent == null ? "" : userAgent);
+        return conn;
+    }
+
+    private static WebResourceResponse responseFor(HttpURLConnection conn, int status, String method) throws IOException {
+        if (status < 100) {
+            conn.disconnect();
+            return null;
+        }
+
+        String contentType = conn.getContentType();
+        String mime = "application/octet-stream";
+        String encoding = null;
+        if (contentType != null && !contentType.isEmpty()) {
+            String[] parts = contentType.split(";");
+            if (!parts[0].trim().isEmpty()) {
+                mime = parts[0].trim();
+            }
+            for (int i = 1; i < parts.length; i++) {
+                String part = parts[i].trim();
+                if (part.toLowerCase(Locale.US).startsWith("charset=")) {
+                    encoding = part.substring("charset=".length()).trim().replace("\"", "");
+                }
+            }
+        }
+
+        Map<String, String> responseHeaders = new HashMap<>();
+        Map<String, List<String>> fields = conn.getHeaderFields();
+        if (fields != null) {
+            for (Map.Entry<String, List<String>> entry : fields.entrySet()) {
+                String key = entry.getKey();
+                if (key == null || isHopByHop(key) || key.equalsIgnoreCase("Content-Encoding") || key.equalsIgnoreCase("Content-Length")) {
+                    continue;
+                }
+                List<String> values = entry.getValue();
+                if (values == null || values.isEmpty()) {
+                    continue;
+                }
+                responseHeaders.put(key, join(values));
+            }
+        }
+        String reason = reason(conn.getResponseMessage(), status);
+
+        InputStream stream;
+        if (method.equals("HEAD") || status == 204 || status == 304) {
+            stream = new ByteArrayInputStream(new byte[0]);
+            conn.disconnect();
+        } else {
+            InputStream raw = status >= 400 ? conn.getErrorStream() : conn.getInputStream();
+            if (raw == null) {
+                raw = new ByteArrayInputStream(new byte[0]);
+                conn.disconnect();
+                stream = raw;
+            } else {
+                stream = new FilterInputStream(raw) {
+                    @Override
+                    public void close() throws IOException {
+                        try {
+                            super.close();
+                        } finally {
+                            conn.disconnect();
+                        }
+                    }
+                };
+            }
+        }
+
+        return new WebResourceResponse(mime, encoding, status, reason, responseHeaders, stream);
+    }
+
+    private static String join(List<String> values) {
+        StringBuilder builder = new StringBuilder();
+        for (String value : values) {
+            if (value == null) {
+                continue;
+            }
+            if (builder.length() > 0) {
+                builder.append(", ");
+            }
+            builder.append(value);
+        }
+        return builder.toString();
+    }
+
+    private static String reason(String value, int status) {
+        String fallback = status == 200 ? "OK" : "Status";
+        if (value == null) {
+            return fallback;
+        }
+        StringBuilder cleaned = new StringBuilder();
+        for (int i = 0; i < value.length(); i++) {
+            char c = value.charAt(i);
+            if (c >= 0x20 && c <= 0x7E) {
+                cleaned.append(c);
+            }
+        }
+        String result = cleaned.toString().trim();
+        return result.isEmpty() ? fallback : result;
+    }
+
+    private static boolean isHopByHop(String name) {
+        return name.equalsIgnoreCase("Connection")
+            || name.equalsIgnoreCase("Keep-Alive")
+            || name.equalsIgnoreCase("Proxy-Authenticate")
+            || name.equalsIgnoreCase("Proxy-Authorization")
+            || name.equalsIgnoreCase("TE")
+            || name.equalsIgnoreCase("Trailer")
+            || name.equalsIgnoreCase("Transfer-Encoding")
+            || name.equalsIgnoreCase("Upgrade")
+            || name.equalsIgnoreCase("Host");
+    }
+}
