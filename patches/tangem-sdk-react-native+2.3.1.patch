+/// Runs a card operation only on the card with the expected card id.
+///
+/// The session starts without a card id, so the SDK does not use its own "wrong card" handling (it keeps
+/// the session open and starts the NFC polling again). The card id is checked here, after the SDK read
+/// the card and before the operation runs. Another card ends the session with `wrongCardNumber` and
+/// nothing is sent to it.
+@available(iOS 13.0, *)
+struct ExpectedCard<Operation: CardSessionRunnable>: CardSessionRunnable {
+    typealias Response = Operation.Response
+
+    let expectedCardId: String
+    let operation: Operation
+
+    var preflightReadMode: PreflightReadMode { operation.preflightReadMode }
+
+    var shouldAskForAccessCode: Bool { operation.shouldAskForAccessCode }
+
+    func prepare(_ session: CardSession, completion: @escaping CompletionResult<Void>) {
+        operation.prepare(session, completion: completion)
+    }
+
+    func run(in session: CardSession, completion: @escaping CompletionResult<Operation.Response>) {
+        guard let cardId = session.environment.card?.cardId,
+              cardId.caseInsensitiveCompare(expectedCardId) == .orderedSame else {
+            completion(.failure(.wrongCardNumber(expectedCardId: expectedCardId)))
+            return
+        }
+        operation.run(in: session, completion: completion)
+    }
+}
