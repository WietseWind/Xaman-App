+/**
+ * Runs a card operation only on the card with the expected card id.
+ *
+ * The session starts without a card id, so the SDK does not use its own "wrong card" handling (it keeps
+ * the session open and starts the NFC polling again, and on some phones that never finds the next card).
+ * The card id is checked here, after the SDK read the card and before the operation runs. Another card
+ * ends the session with WrongCardNumber and nothing is sent to it.
+ */
+class ExpectedCard<T>(
+    private val expectedCardId: String,
+    private val operation: CardSessionRunnable<T>
+) : CardSessionRunnable<T> {
+    override val allowsRequestAccessCodeFromRepository: Boolean
+        get() = operation.allowsRequestAccessCodeFromRepository
+
+    override fun preflightReadMode(): PreflightReadMode = operation.preflightReadMode()
+
+    override fun prepare(session: CardSession, callback: (result: CompletionResult<Unit>) -> Unit) {
+        operation.prepare(session, callback)
+    }
+
+    override fun run(session: CardSession, callback: (result: CompletionResult<T>) -> Unit) {
+        val cardId = session.environment.card?.cardId
+        if (cardId == null || !cardId.equals(expectedCardId, ignoreCase = true)) {
+            callback(CompletionResult.Failure(TangemSdkError.WrongCardNumber()))
+            return
+        }
+        operation.run(session, callback)
+    }
+}
